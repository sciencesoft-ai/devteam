     )
     const { result } = renderHook(() => useTheme(), { wrapper })
     const entry = result.current.allThemes.find((t) => t.value === 'colorblind')
-    expect(entry?.label).toBe('👁️ Color-blind safe')
+    // The picker shows the name alone; the catalog value above keeps its glyph.
+    expect(entry?.label).toBe('Color-blind safe')
   })
 })
