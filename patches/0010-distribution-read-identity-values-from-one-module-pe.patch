index 0000000000000000000000000000000000000000..102adc6589d654795426f318646c9b67e517d284
--- /dev/null
+++ b/src/kiro_crew/_distribution.py
@@ -0,0 +1,48 @@
+"""Distribution identity: the values a downstream rebuild of this product may change.
+
+These are the upstream values. A downstream distribution regenerates this file at
+build time instead of patching each place a value is used (DevTeam generates it from
+``devteam.conf`` with ``scripts/distribution.py``). The Electron shell
+(``website/electron/distribution.js``) and the dashboard (``website/src/distribution.ts``)
+carry the same values and are regenerated together with this file.
+
+Stdlib-free and import-free on purpose: ``kiro_crew/__init__``, ``config.paths`` and
+the security vocabulary import it while the package is still loading.
+"""
+
+#: Display name of the product.
+PRODUCT_NAME = "Kiro Crew"
+
+#: Name of the command this install publishes on PATH (``~/.local/bin/<name>``) and
+#: links into the data home's private bin directory for agents. The in-install
+#: launcher (``bin/kirocrew``, the ``kirocrew`` console script) keeps its name.
+CLI_NAME = "kirocrew"
+
+#: The default data home, as path segments under the user's home directory.
+DATA_HOME_PARTS = (".kiro", "crew")
+
+#: The pre-move top-level home this build migrates from. A downstream build points it
+#: at a name that never exists so it can never adopt another product's data.
+LEGACY_HOME_NAME = ".kirocrew"
+
+#: Recovery pointer written beside the data home (see ``config.paths``).
+RECOVERY_BREADCRUMB_NAME = ".kirocrew.breadcrumb"
+
+#: Directory name of the default LLM workspace root.
+WORKSPACE_DIR_NAME = "kirocrew-workspace"
+
+#: Default dashboard / gateway port.
+DEFAULT_PORT = 5476
+
+#: Runtime id of the harness a config with no ``agent.acp_backend`` choice runs.
+DEFAULT_ACP_BACKEND = "kas"
+
+#: URL scheme of desktop deep links (``<scheme>://...``).
+URL_SCHEME = "kirocrew"
+
+#: systemd unit name and launchd label of the background gateway service.
+SERVICE_NAME = "kirocrew"
+LAUNCHD_LABEL = "dev.kirocrew.gateway"
+
+#: npm package names of the desktop app (stable, nightly).
+DESKTOP_PACKAGE_NAMES = ("kirocrew-desktop", "kirocrew-desktop-nightly")
