From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DevTeam <devteam@localhost>
Date: Wed, 18 Nov 2026 23:03:18 +0000
Subject: [PATCH] distribution: read identity values from one module per
 surface

Adds src/kiro_crew/_distribution.py, website/electron/distribution.js and
website/src/distribution.ts, holding upstream's values, and points every
site that hard-codes one of them there:

- default data home (~/.kiro/crew), legacy home, breadcrumb, workspace dir
- default gateway/dashboard port (5476)
- default harness for a config with no agent.acp_backend (KAS)
- published command name (PATH link, agents' private link, --version,
  CLI usage) and its recognition by the security vocabulary
- deep-link URL scheme, systemd unit / launchd label, desktop package names
- desktop shell: home dir, default port, window title; dashboard: default
  harness and {{productName}}

With upstream values the build behaves as before. A downstream
distribution regenerates the three modules (DevTeam: scripts/distribution.py)
instead of patching each site. A non-upstream data home is exported as
KIROCREW_HOME at startup so child processes resolve the same home.

diff --git a/packaging/build-desktop.sh b/packaging/build-desktop.sh
index aba097e7bf8ff98910010f7498745d5034ccc72f..f89d82727303ba78650286aa4938a5822fef1ce0 100644
--- a/packaging/build-desktop.sh
+++ b/packaging/build-desktop.sh
@@ -44,6 +44,9 @@
 set -euo pipefail
 
 ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+# Command name a downstream distribution publishes (src/kiro_crew/_distribution.py).
+DIST_CLI_NAME="$(sed -n 's/^CLI_NAME = "\(.*\)"$/\1/p' "$ROOT/src/kiro_crew/_distribution.py")"
+DIST_CLI_NAME="${DIST_CLI_NAME:-kirocrew}"
 cd "$ROOT"
 
 # The backend bytecode steps (bytecode_coverage_gate, precompile_macos_backend).
@@ -668,6 +671,10 @@ unset PYTHONPATH PYTHONHOME
 exec "$DIR/python3.12" -s -P -m kiro_crew "$@"
 LAUNCH
   chmod +x "$out/bin/kirocrew"
+  # The distribution's command name: a copy of the same relocatable launcher.
+  if [ "$DIST_CLI_NAME" != kirocrew ]; then
+    cp "$out/bin/kirocrew" "$out/bin/$DIST_CLI_NAME" && chmod +x "$out/bin/$DIST_CLI_NAME"
+  fi
 
   # Arch gate: the bundled interpreter must be the arch this tree claims to be
   # (a mismatch ships an app whose backend crashes at launch on the other arch).
@@ -823,6 +830,7 @@ build_backend_windows() {
   # interactive cmd window keeps their own PYTHONPATH afterwards.
   mkdir -p "$out/bin"
   printf '@echo off\r\nsetlocal\r\nset "PYTHONPATH="\r\nset "PYTHONHOME="\r\n"%%~dp0..\\python.exe" -s -P -m kiro_crew %%*\r\n' > "$out/bin/kirocrew.cmd"
+  if [ "$DIST_CLI_NAME" != kirocrew ]; then cp "$out/bin/kirocrew.cmd" "$out/bin/$DIST_CLI_NAME.cmd"; fi
   # pip also dropped Scripts\kirocrew.exe, whose embedded shebang is THIS build
   # machine's absolute python.exe path, so it dies with "Fatal error in
   # launcher" once the bundle is installed anywhere else. Replace it
@@ -830,6 +838,7 @@ build_backend_windows() {
   # root like bin\, so "%~dp0..\python.exe" resolves the same interpreter.
   rm -f "$out/Scripts/kirocrew.exe" "$out/Scripts/kirocrew-script.py"
   printf '@echo off\r\nsetlocal\r\nset "PYTHONPATH="\r\nset "PYTHONHOME="\r\n"%%~dp0..\\python.exe" -s -P -m kiro_crew %%*\r\n' > "$out/Scripts/kirocrew.cmd"
+  if [ "$DIST_CLI_NAME" != kirocrew ]; then cp "$out/Scripts/kirocrew.cmd" "$out/Scripts/$DIST_CLI_NAME.cmd"; fi
   # Every other pip console script in Scripts\ (httpx, pwcpp, tqdm, ...) has
   # the same frozen shebang, and env.py puts Scripts\ on every agent's PATH.
   # Turn each into a relocatable <name>.cmd; native uv.exe is left alone.
diff --git a/src/kiro_crew/__init__.py b/src/kiro_crew/__init__.py
index 0be9a74abc0324aeeb003fd6610b01c6137752a5..375cf0f7e4db50077344d5165292ddc0ae4acac6 100644
--- a/src/kiro_crew/__init__.py
+++ b/src/kiro_crew/__init__.py
@@ -7,6 +7,15 @@ import logging
 import os
 import re
 
+from kiro_crew import _distribution as _dist
+
+# A distribution whose data home is not upstream's exports it as KIROCREW_HOME when
+# nothing set one, so every child process -- MCP servers, cron scripts, skill
+# scripts that fall back to a literal default -- resolves the same home. Upstream
+# leaves the variable alone; its desktop shell already sets it for the gateway.
+if tuple(_dist.DATA_HOME_PARTS) != (".kiro", "crew") and not os.environ.get("KIROCREW_HOME"):
+    os.environ["KIROCREW_HOME"] = os.path.join(os.path.expanduser("~"), *_dist.DATA_HOME_PARTS)
+
 __version__ = "0.12.2"
 
 # A distribution that repackages one core release as several builds of its own
@@ -164,8 +173,8 @@ def version_line(package_dir: "str | None" = None) -> str:
     if package_dir is None:
         package_dir = os.path.dirname(__file__ or "")
     if _runs_from_source_checkout(package_dir):
-        return f"kirocrew {__version__} {SOURCE_CHECKOUT_NOTE}"
-    return f"kirocrew {__version__}"
+        return f"{_dist.CLI_NAME} {__version__} {SOURCE_CHECKOUT_NOTE}"
+    return f"{_dist.CLI_NAME} {__version__}"
 
 
