@@ -565,12 +569,19 @@ def refresh_own_kirocrew_link() -> str | None:
             return None
         mkdirs_owner_only(directory)
         link = directory / "kirocrew"
-        if link.is_symlink() and os.readlink(link) == target:
+        # The distribution's own command name gets the same private link, so an
+        # agent told to run it reaches this install too.
+        names = dict.fromkeys(("kirocrew", _distribution.CLI_NAME))
+        if all(
+            (directory / name).is_symlink() and os.readlink(directory / name) == target
+            for name in names
+        ):
             return None
-        staged = directory / f".kirocrew.{os.getpid()}.tmp"
-        staged.unlink(missing_ok=True)
-        staged.symlink_to(target)
-        os.replace(staged, link)
+        for name in names:
+            staged = directory / f".{name}.{os.getpid()}.tmp"
+            staged.unlink(missing_ok=True)
+            staged.symlink_to(target)
+            os.replace(staged, directory / name)
     except OSError as exc:
         logger.warning("Could not link this install's kirocrew into the crew home: %s", exc)
         return None
