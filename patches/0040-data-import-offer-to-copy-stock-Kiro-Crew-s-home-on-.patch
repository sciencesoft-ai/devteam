+"use strict";
+const { describe, it, beforeEach, afterEach } = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const DISTRIBUTION = require("../distribution");
+const { shouldOffer, importHome, startFresh, renameWhenUnlocked } = require("../data-import");
+
+const upstream = DISTRIBUTION.DATA_HOME_PARTS.join("/") === ".kiro/crew";
+
+describe("data-import", { skip: upstream && "upstream build never offers an import" }, () => {
+  let root;
+  let deps;
+  beforeEach(() => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), "data-import-"));
+    deps = { env: {}, os: { homedir: () => root } };
+    const source = path.join(root, ".kiro", "crew");
+    fs.mkdirSync(path.join(source, "kirocrew-bin"), { recursive: true });
+    fs.mkdirSync(path.join(source, "history"));
+    fs.writeFileSync(path.join(source, "config.json"), JSON.stringify({ dashboard: { url: "http://localhost:5476" } }));
+    fs.writeFileSync(path.join(source, "gateway.pid"), "1");
+    fs.writeFileSync(path.join(source, "history", "a.jsonl"), "{}");
+  });
+  afterEach(() => fs.rmSync(root, { recursive: true, force: true }));
+
+  it("offers only while this product's home is absent", () => {
+    assert.equal(shouldOffer(deps), true);
+    startFresh(deps);
+    assert.equal(shouldOffer(deps), false);
+  });
+
+  it("copies the home without runtime files and moves the port", async () => {
+    const target = await importHome(deps);
+    assert.ok(fs.existsSync(path.join(target, "history", "a.jsonl")));
+    assert.ok(!fs.existsSync(path.join(target, "gateway.pid")));
+    assert.ok(!fs.existsSync(path.join(target, "kirocrew-bin")));
+    const url = JSON.parse(fs.readFileSync(path.join(target, "config.json"), "utf8")).dashboard.url;
+    assert.equal(url, `http://localhost:${DISTRIBUTION.DEFAULT_PORT}`);
+  });
+});
+
+describe("data-import rename", () => {
+  const locked = () => Object.assign(new Error("EPERM, Permission denied"), { code: "EPERM" });
+  const fakeFs = (failures, { targetExists = false } = {}) => {
+    const calls = [];
+    return {
+      calls,
+      existsSync: () => targetExists,
+      promises: {
+        rename: async (from, to) => {
+          calls.push([from, to]);
+          if (calls.length <= failures) throw locked();
+        },
+      },
+    };
+  };
+  const noWait = async () => {};
+
+  it("retries a folder a Windows scan still holds open", async () => {
+    const fs = fakeFs(3);
+    await renameWhenUnlocked("a", "b", { fs, platform: "win32", wait: noWait });
+    assert.equal(fs.calls.length, 4);
+  });
+
+  it("gives up once the retry window is spent", async () => {
+    const fs = fakeFs(Infinity);
+    await assert.rejects(
+      renameWhenUnlocked("a", "b", { fs, platform: "win32", retryMs: 0, wait: noWait }),
+      { code: "EPERM" },
+    );
+    assert.equal(fs.calls.length, 1);
+  });
+
+  it("does not retry off Windows or onto an existing target", async () => {
+    for (const [platform, targetExists] of [["linux", false], ["win32", true]]) {
+      const fs = fakeFs(Infinity, { targetExists });
+      await assert.rejects(renameWhenUnlocked("a", "b", { fs, platform, wait: noWait }), { code: "EPERM" });
+      assert.equal(fs.calls.length, 1);
+    }
+  });
+});
+
+describe("data-import upstream", () => {
+  it("never offers when the data home is upstream's", { skip: !upstream }, () => {
+    assert.equal(shouldOffer({ env: {} }), false);
+  });
+});
