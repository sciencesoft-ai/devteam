diff --git a/website/electron/test/distribution-env.test.js b/website/electron/test/distribution-env.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..ce7d57c1206ce388ac8afa9d917ddbac73549fce
--- /dev/null
+++ b/website/electron/test/distribution-env.test.js
@@ -0,0 +1,24 @@
+"use strict";
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const { applyDistributionEnv, marker } = require("../distribution-env");
+
+test("upstream prefix leaves the environment alone", () => {
+  const env = { KIROCREW_HOME: "/a", KIROCREW_PORT: "1234" };
+  assert.equal(applyDistributionEnv(env, "KIROCREW"), false);
+  assert.deepEqual(env, { KIROCREW_HOME: "/a", KIROCREW_PORT: "1234" });
+});
+
+test("own prefix replaces another install's KIROCREW_* values", () => {
+  const env = { KIROCREW_HOME: "/other", KIROCREW_PORT: "5476", DEVTEAM_PORT: "6000" };
+  assert.equal(applyDistributionEnv(env, "DEVTEAM"), true);
+  assert.equal(env.KIROCREW_HOME, undefined);
+  assert.equal(env.KIROCREW_PORT, "6000");
+  assert.equal(env[marker("DEVTEAM")], "1");
+});
+
+test("a mapped environment (a child of this product) is trusted as is", () => {
+  const env = { KIROCREW_PORT: "7000", DEVTEAM_ENV_MAPPED: "1" };
+  assert.equal(applyDistributionEnv(env, "DEVTEAM"), false);
+  assert.equal(env.KIROCREW_PORT, "7000");
+});
