+class TestDistributionOptOutName:
+    """A downstream distribution documents ``<prefix>_TELEMETRY_DISABLED``.
+
+    Upstream's spelling stays honored there, so an opt-out set for stock Kiro
+    Crew is never lost to the rename, and the reason names the variable set.
+    """
+
+    @pytest.fixture(autouse=True)
+    def _downstream(self, monkeypatch):
+        names = ("DEVTEAM_TELEMETRY_DISABLED", "KIROCREW_TELEMETRY_DISABLED")
+        monkeypatch.setattr(beacon, "_DISABLE_ENVS", names)
+        for name in names:
+            monkeypatch.delenv(name, raising=False)
+
+    def test_documented_name_follows_the_distribution(self):
+        assert beacon.DISABLE_ENV == f"{beacon._distribution.ENV_PREFIX}_TELEMETRY_DISABLED"
+
+    @pytest.mark.parametrize("name", ["DEVTEAM_TELEMETRY_DISABLED", "KIROCREW_TELEMETRY_DISABLED"])
+    def test_either_name_opts_out(self, _isolated_home, monkeypatch, name):
+        monkeypatch.setenv(name, "1")
+        assert beacon.env_opt_out_var() == name
+        assert beacon.is_env_opted_out() is True
+        ok, reason, code = beacon.should_send(enabled=True, acked=True)
+        assert not ok and code == "env_opt_out" and name in reason
+
+    def test_unset_names_nothing(self, _isolated_home):
+        assert beacon.env_opt_out_var() is None
+
+
 class TestDefaultHomeDetection:
     """Exercises the REAL is_default_home (the suppression fixture stubs it)."""
 
