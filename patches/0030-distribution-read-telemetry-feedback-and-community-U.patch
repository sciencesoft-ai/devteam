@@ -220,7 +224,12 @@ def is_env_opted_out() -> bool:
     environment says so" (a config write would be accepted and then have no
     effect — so the UI disables the control and says why instead).
     """
-    return _env_truthy(DISABLE_ENV)
+    return env_opt_out_var() is not None
+
+
+def env_opt_out_var() -> str | None:
+    """Return the opt-out variable that is set truthy, or ``None``."""
+    return next((name for name in _DISABLE_ENVS if _env_truthy(name)), None)
 
 
