From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Serge A. Salamanka" <ssalamanka@scnsoft.com>
Date: Fri, 27 Nov 2026 21:34:49 +0300
Subject: [PATCH] branding: draw the product mark from its own asset

KiroGhostMark (the agent-identity rail entry, Crew mode) and the Kiro
harness logos read the same file, so a distribution that replaces the
product mark also relabels the Kiro CLI and KAS harnesses. Give the
product its own product-mark.svg (upstream: the same ghost) and draw
the Kiro harnesses with KiroHarnessMark, which keeps Kiro's ghost.

diff --git a/website/src/assets/product-mark.svg b/website/src/assets/product-mark.svg
new file mode 100644
index 0000000000000000000000000000000000000000..8f852bb12bd161d87618768585b0f1e3c2b9953e
--- /dev/null
+++ b/website/src/assets/product-mark.svg
@@ -0,0 +1 @@
+<svg xmlns="http://www.w3.org/2000/svg" viewBox="210 80 805 1030" fill="none" stroke="#000" stroke-width="80" stroke-linejoin="round"><path d="M398.554 818.914C316.315 1001.03 491.477 1046.74 620.672 940.156C658.687 1059.66 801.052 970.473 852.234 877.795C964.787 673.567 919.318 465.357 907.64 422.374C827.637 129.443 427.623 128.946 358.8 423.865C342.651 475.544 342.402 534.18 333.458 595.051C328.986 625.86 325.507 645.488 313.83 677.785C306.873 696.424 297.68 712.819 282.773 740.645C259.915 783.881 269.604 867.113 387.87 823.883L399.051 818.914H398.554Z"/><path fill="#000" stroke="none" d="M636.123 549.353C603.328 549.353 598.359 510.097 598.359 486.742C598.359 465.623 602.086 448.977 609.293 438.293C615.504 428.852 624.697 424.131 636.123 424.131C647.555 424.131 657.492 428.852 664.447 438.541C672.398 449.474 676.623 466.12 676.623 486.742C676.623 525.998 661.471 549.353 636.375 549.353H636.123Z"/><path fill="#000" stroke="none" d="M771.24 549.353C738.445 549.353 733.477 510.097 733.477 486.742C733.477 465.623 737.203 448.977 744.41 438.293C750.621 428.852 759.814 424.131 771.24 424.131C782.672 424.131 792.609 428.852 799.564 438.541C807.516 449.474 811.74 466.12 811.74 486.742C811.74 525.998 796.588 549.353 771.492 549.353H771.24Z"/></svg>
diff --git a/website/src/components/HarnessLogo.tsx b/website/src/components/HarnessLogo.tsx
index f18837c4b3e548426b40fc535ae8ef38ba454264..17cbb3cd70535045240f7e49b7b5f5a4feab9b17 100644
--- a/website/src/components/HarnessLogo.tsx
+++ b/website/src/components/HarnessLogo.tsx
@@ -13,7 +13,7 @@
 import { Boxes } from 'lucide-react'
 import { KIRO_HARNESS_BACKENDS } from '../api/acpBackend'
 import { BrandGlyph } from './BrandIcon'
-import { KiroGhostMark } from './KiroGhostMark'
+import { KiroHarnessMark } from './KiroGhostMark'
 import claudeMarkUrl from '../assets/harness-logos/claude.svg'
 import copilotMarkUrl from '../assets/harness-logos/copilot.svg'
 import deepseekMarkUrl from '../assets/harness-logos/deepseek.svg'
@@ -24,7 +24,7 @@ import piMarkUrl from '../assets/harness-logos/pi.svg'
 
 /**
  * Brand mark per harness id, keyed by the wire id the server sends. Kiro's two
- * harnesses (`kiro` = Kiro CLI, `kas` = kiro-agent) are drawn by `KiroGhostMark`
+ * harnesses (`kiro` = Kiro CLI, `kas` = kiro-agent) are drawn by `KiroHarnessMark`
  * below rather than listed here, so they share the one Kiro asset.
  */
 const HARNESS_MARK_URL: Readonly<Record<string, string>> = {
@@ -46,7 +46,7 @@ const KIRO_HARNESSES: ReadonlySet<string> = new Set(KIRO_HARNESS_BACKENDS)
  * @param size  Box edge in px (default 14, matching the list's other glyphs).
  */
 export function HarnessLogo({ id, size = 14 }: { id: string; size?: number }) {
-  if (KIRO_HARNESSES.has(id)) return <KiroGhostMark size={size} />
+  if (KIRO_HARNESSES.has(id)) return <KiroHarnessMark size={size} />
   const url = Object.hasOwn(HARNESS_MARK_URL, id) ? HARNESS_MARK_URL[id] : undefined
   if (url) return <BrandGlyph url={url} size={size} testId={`harness-logo-${id}`} />
   return <Boxes size={size} aria-hidden="true" data-testid="harness-logo-fallback" />
diff --git a/website/src/components/KiroGhostMark.tsx b/website/src/components/KiroGhostMark.tsx
index 57d66f141bf5abdc15fc8cc48bb3446f6eed9f3d..742dad51b9f997d1d4a40363b3ac744c7bde9265 100644
--- a/website/src/components/KiroGhostMark.tsx
+++ b/website/src/components/KiroGhostMark.tsx
@@ -17,6 +17,10 @@
 // hollow body keeps its visual weight in line with those stroke-drawn glyphs.
 import { BrandGlyph } from './BrandIcon'
 import ghostMarkUrl from '../assets/kiro-ghost-mark.svg'
+// The PRODUCT's mark (the agent-identity rail entry, Crew mode). Upstream it is the
+// same ghost; a downstream distribution replaces this one file with its own mark,
+// while the Kiro harnesses keep Kiro's ghost through `KiroHarnessMark` below.
+import productMarkUrl from '../assets/product-mark.svg'
 
 /**
  * Kiro ghost brand glyph.
@@ -25,5 +29,10 @@ import ghostMarkUrl from '../assets/kiro-ghost-mark.svg'
  *              matching the `size={16}` Lucide glyphs in the nav rail).
  */
 export function KiroGhostMark({ size = 16, className = 'inline-block shrink-0' }: { size?: number; className?: string }) {
+  return <BrandGlyph url={productMarkUrl} size={size} className={className} testId="kiro-ghost-mark" />
+}
+
+/** Kiro's own ghost, for the Kiro harnesses (`kiro`, `kas`): it names Kiro, not this product. */
+export function KiroHarnessMark({ size = 16, className = 'inline-block shrink-0' }: { size?: number; className?: string }) {
   return <BrandGlyph url={ghostMarkUrl} size={size} className={className} testId="kiro-ghost-mark" />
 }
